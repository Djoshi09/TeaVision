<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_surface"
    tools:context=".AnalyticsActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/analyticsScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Modern Gradient Header -->
            <FrameLayout
                android:id="@+id/analyticsHeroHeader"
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:background="@drawable/gradient_primary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="26dp"
                    android:gravity="bottom"
                    android:background="@drawable/overlay_gradient">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/analytics_dashboard"
                        android:textSize="33sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/analytics_subtitle"
                        android:textSize="14sp"
                        android:textColor="#EDE2D5" />

                </LinearLayout>

            </FrameLayout>

            <!-- Content -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:paddingBottom="24dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <!-- Tea Distribution Pie Chart -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/distributionCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:layout_marginTop="-44dp"
                    android:elevation="10dp"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardElevation="10dp"
                    app:cardCornerRadius="24dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#1FA67C52">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tea_distribution"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_teal"
                            android:layout_marginBottom="16dp" />

                        <com.github.mikephil.charting.charts.PieChart
                            android:id="@+id/teaDistributionPieChart"
                            android:layout_width="match_parent"
                            android:layout_height="300dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Weekly Consumption Bar Chart -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/weeklyCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardElevation="4dp"
                    app:cardCornerRadius="20dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/overlay_light">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/weekly_consumption"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/secondary_purple"
                            android:layout_marginBottom="16dp" />

                        <com.github.mikephil.charting.charts.BarChart
                            android:id="@+id/weeklyConsumptionBarChart"
                            android:layout_width="match_parent"
                            android:layout_height="350dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Line Chart - Scan Frequency Trend -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/trendCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardElevation="4dp"
                    app:cardCornerRadius="20dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/overlay_light">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/scan_frequency_trend"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/success_green"
                            android:layout_marginBottom="16dp" />

                        <com.github.mikephil.charting.charts.LineChart
                            android:id="@+id/frequencyTrendLineChart"
                            android:layout_width="match_parent"
                            android:layout_height="300dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Statistics Summary Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/statisticsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardElevation="4dp"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="#F0F9FF"
                    app:strokeWidth="1dp"
                    app:strokeColor="#BFDBFE">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/statistics"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_teal"
                            android:layout_marginBottom="16dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:baselineAligned="false"
                            android:layout_marginBottom="12dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:padding="12dp"
                                android:background="@drawable/stat_card_background">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/total_scans"
                                    android:textSize="12sp"
                                    android:textColor="@color/text_secondary"
                                    android:layout_marginBottom="4dp" />

                                <TextView
                                    android:id="@+id/totalScansValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/zero"
                                    android:textSize="24sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/primary_teal" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:padding="12dp"
                                android:background="@drawable/stat_card_background"
                                android:layout_marginStart="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/confirmed"
                                    android:textSize="12sp"
                                    android:textColor="@color/text_secondary"
                                    android:layout_marginBottom="4dp" />

                                <TextView
                                    android:id="@+id/confirmedScansValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/zero"
                                    android:textSize="24sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/success_green" />

                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:baselineAligned="false">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:padding="12dp"
                                android:background="@drawable/stat_card_background">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/unique_types"
                                    android:textSize="12sp"
                                    android:textColor="@color/text_secondary"
                                    android:layout_marginBottom="4dp" />

                                <TextView
                                    android:id="@+id/uniqueTypesValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/zero"
                                    android:textSize="24sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/secondary_purple" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:padding="12dp"
                                android:background="@drawable/stat_card_background"
                                android:layout_marginStart="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/favorite_tea"
                                    android:textSize="12sp"
                                    android:textColor="@color/text_secondary"
                                    android:layout_marginBottom="4dp" />

                                <TextView
                                    android:id="@+id/favoriteTeaValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/dash"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/primary_teal"
                                    android:maxLines="1"
                                    android:ellipsize="end" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
