<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_surface"
    tools:context=".MainActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Modern Gradient Header -->
            <FrameLayout
                android:id="@+id/heroHeader"
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:background="@drawable/gradient_primary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="@dimen/space_3xl"
                    android:gravity="bottom"
                    android:background="@drawable/overlay_gradient">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hero_title"
                        style="@style/TextAppearance.Tea.HeroTitle"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hero_subtitle"
                        android:textSize="@dimen/text_body"
                        android:textColor="#EDE2D5"
                        android:layout_marginBottom="@dimen/space_sm" />

                </LinearLayout>

            </FrameLayout>

            <!-- Content with negative margin for floating cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:paddingBottom="24dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">


                <!-- Scan Action Card - Floating -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/scanCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    android:layout_marginTop="-46dp"
                    android:elevation="10dp"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardElevation="10dp"
                    app:cardCornerRadius="@dimen/radius_2xl"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_soft">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="@string/scan_tea"
                            style="@style/TextAppearance.Tea.SectionTitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:text="@string/scan_smart_desc"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary" />

                        <!-- Main Smart Scan Button -->
                        <FrameLayout
                            android:id="@+id/smartScanContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/smartScanButton"
                                android:layout_width="120dp"
                                android:layout_height="120dp"
                                android:layout_gravity="center"
                                android:text=""
                                app:cornerRadius="60dp"
                                app:backgroundTint="@color/primary_teal"
                                app:icon="@android:drawable/ic_menu_camera"
                                app:iconSize="48dp"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconTint="@color/white"
                                android:elevation="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginTop="32dp"
                                android:text="@string/scan_tea"
                                android:textColor="@color/white"
                                android:textStyle="bold"
                                android:textSize="12sp" />

                        </FrameLayout>

                        <LinearLayout
                            android:id="@+id/secondaryScanModes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <!-- Image Scan Button -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/scanImageButton"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:text="@string/scan_tea_image"
                                android:textAllCaps="false"
                                android:textSize="14sp"
                                app:cornerRadius="@dimen/radius_md"
                                app:backgroundTint="@color/primary_teal"
                                app:icon="@android:drawable/ic_menu_camera"
                                app:iconTint="@color/white"
                                app:iconPadding="6dp"
                                android:textColor="@color/white"
                                android:layout_marginBottom="10dp" />

                            <!-- Barcode Scan Button -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/scanBarcodeButton"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:text="@string/scan_barcode_btn"
                                android:textAllCaps="false"
                                android:textSize="14sp"
                                app:cornerRadius="@dimen/radius_md"
                                app:backgroundTint="@color/primary_teal"
                                app:icon="@android:drawable/ic_menu_view"
                                app:iconTint="@color/white"
                                app:iconPadding="6dp"
                                android:textColor="@color/white"
                                android:layout_marginBottom="10dp" />

                            <!-- Text Scan Button -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/scanTextButton"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:text="@string/scan_text_label"
                                android:textAllCaps="false"
                                android:textSize="14sp"
                                app:cornerRadius="@dimen/radius_md"
                                app:backgroundTint="@color/primary_teal"
                                app:icon="@android:drawable/ic_dialog_info"
                                app:iconTint="@color/white"
                                app:iconPadding="6dp"
                                android:textColor="@color/white" />

                        </LinearLayout>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/lookupSourceTagChip"
                            style="@style/Widget.MaterialComponents.Chip.Action"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/lookup_source_default"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:visibility="gone"
                            app:chipBackgroundColor="@color/primary_teal"
                            app:chipIconVisible="true"
                            app:chipMinHeight="34dp"
                            app:chipStrokeColor="#33FFFFFF"
                            app:chipStrokeWidth="1dp"
                            app:closeIconVisible="false" />

                        <TextView
                            android:id="@+id/scanResultMetaText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:visibility="gone"
                            tools:text="Matched via Image Recognition • Confidence: 91%" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Unmapped Barcode Warning Banner -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/unmappedBarcodeBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone"
                    app:cardElevation="2dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="#FFF5E6"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E89A4A">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/unmappedBarcodeText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/unmapped_barcode_default"
                            android:textColor="#8A4B08"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/mapBarcodeButton"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:text="@string/add_product"
                                android:textColor="@color/white"
                                app:backgroundTint="#D47A2C"
                                app:cornerRadius="12dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/dismissBarcodeBannerButton"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:layout_marginStart="8dp"
                                android:text="@string/dismiss"
                                app:cornerRadius="12dp"
                                app:backgroundTint="#F0D9C0"
                                android:textColor="#8A4B08" />

                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Tea Selection Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/selectionCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardElevation="4dp"
                    app:cardCornerRadius="24dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_soft">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/select_tea"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="12dp" />

                        <Spinner
                            android:id="@+id/teaTypeSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginBottom="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/confirmButton"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="@string/confirm_selection"
                            android:textSize="16sp"
                            app:cornerRadius="14dp"
                            app:backgroundTint="@color/success_green" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Nutritional Information Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/nutritionCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardElevation="4dp"
                    app:cardCornerRadius="24dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_soft">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/nutritional_info"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_teal"
                            android:layout_marginBottom="16dp" />

                        <ScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxHeight="300dp">

                            <TableLayout
                                android:id="@+id/nutrientTable"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:stretchColumns="0,1">

                                <TableRow>
                                    <TextView
                                        android:text="@string/nutrient"
                                        android:textStyle="bold"
                                        android:textColor="@color/text_primary"
                                        android:textSize="14sp"
                                        android:padding="10dp" />
                                    <TextView
                                        android:text="@string/value"
                                        android:textStyle="bold"
                                        android:textColor="@color/text_primary"
                                        android:textSize="14sp"
                                        android:padding="10dp"
                                        android:gravity="end" />
                                </TableRow>

                                <TableRow android:background="@color/surface_light">
                                    <TextView
                                        android:text="@string/calories"
                                        android:textColor="@color/text_secondary"
                                        android:padding="10dp" />
                                    <TextView
                                        android:id="@+id/caloriesValue"
                                        android:text="@string/dash"
                                        android:textColor="@color/primary_teal"
                                        android:textStyle="bold"
                                        android:padding="10dp"
                                        android:gravity="end" />
                                </TableRow>

                                <TableRow>
                                    <TextView
                                        android:text="@string/protein"
                                        android:textColor="@color/text_secondary"
                                        android:padding="10dp" />
                                    <TextView
                                        android:id="@+id/proteinValue"
                                        android:text="@string/dash"
                                        android:textColor="@color/secondary_purple"
                                        android:textStyle="bold"
                                        android:padding="10dp"
                                        android:gravity="end" />
                                </TableRow>

                                <TableRow android:background="@color/surface_light">
                                    <TextView
                                        android:text="@string/carbohydrates"
                                        android:textColor="@color/text_secondary"
                                        android:padding="10dp" />
                                    <TextView
                                        android:id="@+id/carbsValue"
                                        android:text="@string/dash"
                                        android:textColor="@color/primary_teal"
                                        android:textStyle="bold"
                                        android:padding="10dp"
                                        android:gravity="end" />
                                </TableRow>

                                <TableRow>
                                    <TextView
                                        android:text="@string/fat"
                                        android:textColor="@color/text_secondary"
                                        android:padding="10dp" />
                                    <TextView
                                        android:id="@+id/fatValue"
                                        android:text="@string/dash"
                                        android:textColor="@color/secondary_purple"
                                        android:textStyle="bold"
                                        android:padding="10dp"
                                        android:gravity="end" />
                                </TableRow>

                                <TableRow android:background="@color/surface_light">
                                    <TextView
                                        android:text="@string/calcium"
                                        android:textColor="@color/text_secondary"
                                        android:padding="10dp" />
                                    <TextView
                                        android:id="@+id/calciumValue"
                                        android:text="@string/dash"
                                        android:textColor="@color/primary_teal"
                                        android:textStyle="bold"
                                        android:padding="10dp"
                                        android:gravity="end" />
                                </TableRow>

                                <TableRow>
                                    <TextView
                                        android:text="@string/magnesium"
                                        android:textColor="@color/text_secondary"
                                        android:padding="10dp" />
                                    <TextView
                                        android:id="@+id/magnesiumValue"
                                        android:text="@string/dash"
                                        android:textColor="@color/secondary_purple"
                                        android:textStyle="bold"
                                        android:padding="10dp"
                                        android:gravity="end" />
                                </TableRow>

                            </TableLayout>

                        </ScrollView>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Health Benefits Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/benefitsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardElevation="4dp"
                    app:cardCornerRadius="24dp"
                    app:cardBackgroundColor="#FDFDF2"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_soft">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/health_benefits"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#6B8E23"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:id="@+id/doctorRemarkText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/health_benefits_default"
                            android:textSize="14sp"
                            android:textColor="#6B4423"
                            android:lineSpacingExtra="5dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- History Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/historyCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardElevation="4dp"
                    app:cardCornerRadius="24dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_soft">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/scan_history"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/secondary_purple"
                            android:layout_marginBottom="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/viewLogsButton"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="@string/view_history"
                            android:textSize="16sp"
                            app:cornerRadius="14dp"
                            app:backgroundTint="@color/secondary_purple"
                            android:textColor="@color/white" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Analytics Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/analyticsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="4dp"
                    app:cardCornerRadius="24dp"
                    app:cardBackgroundColor="#FFF8F0"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_soft">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/analytics_dashboard"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#A67C52"
                            android:layout_marginBottom="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/analyticsButton"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="@string/view_analytics"
                            android:textSize="16sp"
                            app:cornerRadius="14dp"
                            app:backgroundTint="#A67C52"
                            android:textColor="@color/white" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
